from collections import Counter
from typing import List

class Solution:
    def findSubstring(self, s: str, words: List[str]) -> List[int]:
        if not s or not words:
            return []
            
        word_len = len(words[0])
        total_words = len(words)
        total_len = word_len * total_words
        
        target_counts = Counter(words)
        starting_indices = []
        
        for offset in range(word_len):
            left = offset
            right = offset
            current_counts = Counter()
            words_matched = 0
            
            while right + word_len <= len(s):
                word = s[right : right + word_len]
                right += word_len
                
                if word in target_counts:
                    current_counts[word] += 1
                    words_matched += 1
                    
                    while current_counts[word] > target_counts[word]:
                        left_word = s[left : left + word_len]
                        current_counts[left_word] -= 1
                        words_matched -= 1
                        left += word_len
                        
                    if words_matched == total_words:
                        starting_indices.append(left)
                        
                else:
                    current_counts.clear()
                    words_matched = 0
                    left = right
                    
        return starting_indices
