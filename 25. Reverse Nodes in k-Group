from typing import Optional

class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

class Solution:
    def reverseKGroup(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        
        if not head or k == 1:
            return head
        
        
        dummy = ListNode(0)
        dummy.next = head
        
       
        before_group = dummy
        
        while True:
            
            end_of_group = before_group
            for _ in range(k):
                end_of_group = end_of_group.next
                if not end_of_group:
                   
                    return dummy.next
            
           
            after_group = end_of_group.next
            
            
            prev = after_group
            curr = before_group.next
            
            while curr != after_group:
                next_node = curr.next
                curr.next = prev
                prev = curr
                curr = next_node
            
            
            first_node_of_group = before_group.next
            before_group.next = end_of_group
            
            
            before_group = first_node_of_group
