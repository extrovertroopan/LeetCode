import heapq
from typing import List, Optional


class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next

class Solution:
    def mergeKLists(self, lists: List[Optional[ListNode]]) -> Optional[ListNode]:
        
        class HeapNode:
            def __init__(self, node):
                self.node = node
            def __lt__(self, other):
                return self.node.val < other.node.val
        
        min_heap = []
        
        
        for head in lists:
            if head:
                heapq.heappush(min_heap, HeapNode(head))
        
        dummy = ListNode(0)
        curr = dummy
        
        
        while min_heap:
            heap_node = heapq.heappop(min_heap)
            curr.next = heap_node.node
            curr = curr.next
            
            if curr.next:
                heapq.heappush(min_heap, HeapNode(curr.next))
                
        return dummy.next
