from typing import List

class Solution:
    def countServers(self, n: int, logs: List[List[int]], x: int, queries: List[int]) -> List[int]:
        # 1. Sort logs by time
        logs.sort(key=lambda log: log[1])
        
        # 2. Store original query indices and sort queries by time
        sorted_queries = sorted(enumerate(queries), key=lambda q: q[1])
        
        ans = [0] * len(queries)
        server_counts = [0] * (n + 1)
        active_servers = 0
        
        left = 0
        right = 0
        num_logs = len(logs)
        
        # 3. Process queries using sliding window
        for orig_idx, q_time in sorted_queries:
            window_start = q_time - x
            window_end = q_time
            
            # Expand right pointer: include logs with time <= window_end
            while right < num_logs and logs[right][1] <= window_end:
                server_id = logs[right][0]
                if server_counts[server_id] == 0:
                    active_servers += 1
                server_counts[server_id] += 1
                right += 1
                
            # Shrink left pointer: remove logs with time < window_start
            while left < num_logs and logs[left][1] < window_start:
                server_id = logs[left][0]
                server_counts[server_id] -= 1
                if server_counts[server_id] == 0:
                    active_servers -= 1
                left += 1
                
            # Servers that received zero requests in [q - x, q]
            ans[orig_idx] = n - active_servers
            
        return ans
