from typing import List

class Solution:
    def solveSudoku(self, board: List[List[str]]) -> None:
        # bitmasks to track used numbers (1-9 mapped to bits 1-9)
        rows = [0] * 9
        cols = [0] * 9
        boxes = [0] * 9
        
        # Step 1: Record initial numbers already on the board
        for r in range(9):
            for c in range(9):
                if board[r][c] != '.':
                    val = int(board[r][c])
                    mask = 1 << val
                    box_idx = (r // 3) * 3 + (c // 3)
                    
                    rows[r] |= mask
                    cols[c] |= mask
                    boxes[box_idx] |= mask

        # Step 2: Backtracking function using bitmasks
        def backtrack(r: int, c: int) -> bool:
            if r == 9:
                return True
            if c == 9:
                return backtrack(r + 1, 0)
            if board[r][c] != '.':
                return backtrack(r, c + 1)
                
            box_idx = (r // 3) * 3 + (c // 3)
            
            for num in range(1, 10):
                mask = 1 << num
                # If the bit is already 1, the number is used
                if not (rows[r] & mask) and not (cols[c] & mask) and not (boxes[box_idx] & mask):
                    # Place number and update bitmasks
                    board[r][c] = str(num)
                    rows[r] |= mask
                    cols[c] |= mask
                    boxes[box_idx] |= mask
                    
                    if backtrack(r, c + 1):
                        return True
                        
                    # Undo choices (Backtrack)
                    board[r][c] = '.'
                    rows[r] &= ~mask
                    cols[c] &= ~mask
                    boxes[box_idx] &= ~mask
                    
            return False

        backtrack(0, 0)
