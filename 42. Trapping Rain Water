from typing import List

class Solution:
    def trap(self, height: List[int]) -> int:
        if not height:
            return 0
            
        left_index = 0
        right_index = len(height) - 1
        
        tallest_left_wall = 0
        tallest_right_wall = 0
        
        total_water_trapped = 0
        
        # Walk both markers inward until they meet in the middle
        while left_index < right_index:
            
            # We always process the side with the shorter ground level 
            # because the lower side safely dictates the maximum water capacity.
            if height[left_index] < height[right_index]:
                
                # Check if we found a new tallest wall on the left side
                if height[left_index] >= tallest_left_wall:
                    tallest_left_wall = height[left_index]
                else:
                    # If the current ground is lower than our peak wall, it traps water!
                    total_water_trapped += tallest_left_wall - height[left_index]
                    
                left_index += 1
                
            else:
                # Check if we found a new tallest wall on the right side
                if height[right_index] >= tallest_right_wall:
                    tallest_right_wall = height[right_index]
                else:
                    # If the current ground is lower than our peak wall, it traps water!
                    total_water_trapped += tallest_right_wall - height[right_index]
                    
                right_index -= 1
                
        return total_water_trapped
