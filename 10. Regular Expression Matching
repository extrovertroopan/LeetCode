class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        # Dictionary to store the results of subproblems
        memo = {}
        
        def dfs(i: int, j: int) -> bool:
            # Check memoization cache
            if (i, j) in memo:
                return memo[(i, j)]
            
            # Base Case: If we reached the end of the pattern
            if j == len(p):
                # The match is valid only if we also reached the end of the string
                return i == len(s)
            
            # Check if the current characters match
            current_match = i < len(s) and (s[i] == p[j] or p[j] == '.')
            
            # Handle the '*' wildcard logic
            if j + 1 < len(p) and p[j + 1] == '*':
                # Case A: Skip the element and the '*' (0 occurrences)
                # Case B: Match 1 or more occurrences (requires current character match)
                ans = dfs(i, j + 2) or (current_match and dfs(i + 1, j))
            else:
                # Normal character or '.' match without a '*' following it
                ans = current_match and dfs(i + 1, j + 1)
            
            # Save the computed result into memory
            memo[(i, j)] = ans
            return ans
        
        return dfs(0, 0)
