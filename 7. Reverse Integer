class Solution:
    def reverse(self, x: int) -> int:
        INT_MIN, INT_MAX = -2**31, 2**31 - 1
        
        rev = 0
        # Handle negative numbers properly with sign preservation
        sign = -1 if x < 0 else 1
        x = abs(x)
        
        while x != 0:
            digit = x % 10
            x //= 10
            
            # Check for overflow before pushing the digit
            if rev > (INT_MAX - digit) // 10:
                return 0
                
            rev = rev * 10 + digit
            
        return sign * rev
